{
  "name": "@findixi/mobile-business",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:lan": "expo start --host lan",
    "start:lan:clear": "expo start --host lan -c",
    "start:tunnel": "expo start --host tunnel",
    "start:tunnel:clear": "expo start --host tunnel -c",
    "health:check": "node ./scripts/health-check.mjs",
    "route:check": "node ./scripts/route-check.mjs",
    "typecheck": "tsc --noEmit",
    "qa:smoke": "npm run health:check && npm run typecheck && npm run route:check",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "build:preview": "eas build --profile preview --platform all",
    "build:production": "eas build --profile production --platform all",
    "submit": "eas submit --profile production",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo-google-fonts/anton": "^0.4.2",
    "@expo-google-fonts/bebas-neue": "^0.4.1",
    "@expo-google-fonts/caveat": "^0.4.2",
    "@expo-google-fonts/cormorant-garamond": "^0.4.1",
    "@expo-google-fonts/dancing-script": "^0.4.2",
    "@expo-google-fonts/fjalla-one": "^0.4.1",
    "@expo-google-fonts/great-vibes": "^0.4.1",
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/kanit": "^0.4.1",
    "@expo-google-fonts/libre-baskerville": "^0.4.3",
    "@expo-google-fonts/merriweather": "^0.4.2",
    "@expo-google-fonts/montserrat": "^0.4.2",
    "@expo-google-fonts/mulish": "^0.4.2",
    "@expo-google-fonts/nunito": "^0.4.2",
    "@expo-google-fonts/open-sans": "^0.4.2",
    "@expo-google-fonts/oswald": "^0.4.2",
    "@expo-google-fonts/pacifico": "^0.4.1",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@expo-google-fonts/poppins": "^0.4.1",
    "@expo-google-fonts/roboto": "^0.4.3",
    "@expo-google-fonts/source-sans-pro": "^0.2.3",
    "@expo-google-fonts/work-sans": "^0.4.2",
